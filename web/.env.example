# Copy to .env.local and fill in. Never commit real values.

# --- Site ---------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3103
# openssl rand -base64 32
NEXTAUTH_SECRET=
# Public site URL for robots.txt / sitemap (defaults to https://getbook.ie)
BOOKIE_SITE_URL=

# --- Microsoft Entra sign-in (multi-tenant app registration) -----------
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_MULTI_TENANT=true
# Only when single-tenant:
AZURE_AD_TENANT_ID=
# Organisations that may use Bookie: Entra tenant ids (GUIDs), comma-separated. Include your own
# tenant: none is built in. Everyone else sees "Your organisation isn't set up on Bookie yet".
# Set it BEFORE deploying, or every other organisation is locked out. See docs/ACCESS.adoc.
APPROVED_TENANT_IDS=
# Host tenants guests (e.g. an external accountant) can sign in to, as tenantId:Name;tenantId2:Name2.
# Each adds a "Sign in to <Name>" link and needs the redirect URI /api/auth/callback/azure-ad-<first 8 of tenantId>.
# See docs/ACCESS.adoc.
# BOOKIE_GUEST_TENANTS=

# --- Sealed connection settings ----------------------------------------
# 32 random bytes, base64 (openssl rand -base64 32). Keep in Key Vault in production.
BOOKIE_CONFIG_KEY=
# sharepoint (default: the tenant's own SharePoint) | file (dev / self-host)
BOOKIE_CONFIG_STORE=sharepoint
BOOKIE_CONFIG_DIR=.bookie-config

# --- Bitcoin wallets (docs/BITCOIN.adoc) ---------------------------------
# Electrum server: ssl://host:port (recommended) or tcp://host:port. Unset = no wallet data.
BOOKIE_ELECTRUM_URL=
# 1 when you run this server yourself; otherwise the UI shows a privacy warning.
BOOKIE_ELECTRUM_TRUSTED=
# Optional SHA-256 fingerprint to pin a self-signed TLS certificate.
BOOKIE_ELECTRUM_CERT_SHA256=

# --- Xero "Connect to Xero" (OAuth 2.0 web app) -------------------------
# Optional. Without these, users can still add Custom Connection keys.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Space-separated granular scopes; defaults are in src/lib/connectors/xero/oauth.ts
XERO_OAUTH_SCOPES=

# --- Bookie (Azure OpenAI) ----------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# Leave empty to use managed identity (Cognitive Services OpenAI User).
AZURE_OPENAI_API_KEY=
BOOKIE_CHAT_DEPLOYMENT=gpt-6.1-sol
# 1 turns Bookie off even when the endpoint is set (the e2e tests set it).
BOOKIE_DISABLE_AI=
# In-browser voice (realtime over WebRTC); optional separate resource
AZURE_VOICE_ENDPOINT=
BOOKIE_VOICE_DEPLOYMENT=gpt-realtime-2.1
BOOKIE_VOICE=cedar
# "Call on Teams" calls the first agent in Settings › Email (its Teams user, else its mailbox).

# --- Bookie's public helper on the website (docs/PUBLIC_ASSISTANT.adoc) --
# Its OWN Azure OpenAI resource, never the portal's or the agent's. In
# development only, if PUBLIC_AZURE_OPENAI_ENDPOINT is empty, the portal
# settings above are borrowed for local testing; production never falls back.
PUBLIC_BOOKIE_ENABLED=true
PUBLIC_AZURE_OPENAI_ENDPOINT=
# Leave empty to use managed identity (Cognitive Services OpenAI User on the public resource).
PUBLIC_AZURE_OPENAI_API_KEY=
PUBLIC_BOOKIE_CHAT_DEPLOYMENT=
PUBLIC_BOOKIE_VOICE_DEPLOYMENT=
PUBLIC_BOOKIE_VOICE=cedar
# 32+ random bytes: signs the human-check pass and Bookie's chat replies.
PUBLIC_BOOKIE_SECRET=
# Cloudflare Turnstile (both set: Turnstile; otherwise a proof-of-work check).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Optional: PUBLIC_BOOKIE_POW_BITS=16, PUBLIC_BOOKIE_ALLOWED_ORIGINS=https://staging.example,
# PUBLIC_BOOKIE_CLIENT_IP_HEADER=cf-connecting-ip, PUBLIC_BOOKIE_CHAT_DAILY_CAP=3000,
# PUBLIC_BOOKIE_VOICE_DAILY_CAP=100, PUBLIC_BOOKIE_VOICE_MAX_CONCURRENT=5

# --- Development only (refused in production builds) -------------------
# azure-cli: act as the Azure CLI user. demo: fictional demo organisations.
# demo-guest: a fictional guest accountant who can see Contoso Coffee Roasters only.
# demo-unapproved: a fictional Fabrikam user whose organisation isn't approved.
# BOOKIE_DEV_AUTH=demo
