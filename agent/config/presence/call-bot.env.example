# Bookie's Agent Presence call-bot environment: ~/presence/src/call-bot/.env (owner bookie, chmod 600).
# Written by agent/deploy/23-setup-call-bot.sh from this file plus config.env; secrets are filled in
# on the VM, never here. Everything not listed keeps agent-presence's own default
# (~/presence/src/call-bot/.env.example documents every knob). No inline comments on value lines.

# ---- Identity (data, not code) ---------------------------------------------------------------
AGENT_NAME=bookie
AGENT_DISPLAY_NAME=Bookie
AGENT_EMAIL=
TEAMS_EMAIL=
# Teams web sign-in for the presence browser. MFA codes come from Presence's totp.mjs with the seed
# in ~/.hermes/graph-subscriptions.env (TOTP_SECRET). Fill both on the VM.
TEAMS_PASSWORD=
INTERNAL_DOMAINS=
CALL_TRANSCRIPTS_DIR=/home/bookie/call-transcripts
AVATAR_STATE_DIR=/home/bookie/call-transcripts
PRESENCE_STATE_DIR=/home/bookie/.hermes
# Rendered from agent/hermes/voice_persona.md by step 04 (placeholders filled).
VOICE_PERSONA_FILE=/home/bookie/.hermes/voice_persona.md

# ---- Avatar (docs/AVATAR-IDENTITY.md in agent-presence) ---------------------------------------
PRESENCE_AVATAR_CONFIG=/home/bookie/bookie/agent/assets/bookie-avatar.json
AVATAR_BADGE=BOOKIE
AVATAR_LABEL=Bookie-Avatar
AVATAR_MODE=robot
AVATAR_FPS=20
DEEP_FEED_PROVIDER=hermes
HERMES_UNIT=hermes-gateway-bookie

# ---- LiveKit (local only; step 23 generates the pair) ----------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Brain seam: ask_deepbrain -> Hermes API server ---------------------------------------------
DEEPBRAIN_API=chat
DEEPBRAIN_URL=http://127.0.0.1:8642
DEEPBRAIN_API_KEY=
DEEPBRAIN_MODEL=gpt-6.1-sol
DEEPBRAIN_REASONING_EFFORT=low
HUD_BRAIN_MODEL=gpt-6.1-sol
USAGE_PROVIDER=none

# ---- Voice: GPT-Live-1 on Azure (docs/GPT-LIVE.md) -------------------------------------------
VOICE_MODE=realtime
VOICE_REALTIME_PROVIDER=openai-live
VOICE_LIVE_MODEL=gpt-live-1
VOICE_LIVE_VOICE=cedar
VOICE_LIVE_MAX_SESSION_S=3600
# azure = bill an Azure resource, never OpenAI direct. Refuses to start without endpoint + deployment.
VOICE_LIVE_PROVIDER=azure
# Bookie's own resource once his gpt-live-1 quota is granted. Until then: the resource that holds the
# subscription's gpt-live-1 quota (the VM identity needs Cognitive Services OpenAI User on it, and
# AZURE_LIVE_BACKEND_DEPLOYMENT must exist on that same resource).
AZURE_LIVE_ENDPOINT=https://<resource>.openai.azure.com
AZURE_LIVE_DEPLOYMENT=gpt-live-1
AZURE_LIVE_API_VERSION=
# Fallback only: the VM's managed identity is tried first on every connection.
AZURE_LIVE_API_KEY=
AZURE_LIVE_BACKEND_DEPLOYMENT=gpt-6.1-sol
# Rollback (one line, then restart call-bot-bookie): VOICE_REALTIME_PROVIDER=openai (gpt-realtime-2.1).
# Presence (as of 2026-10) routes only gpt-live to Azure (agent/live_azure.py); its `openai` provider
# is OpenAI direct and needs OPENAI_API_KEY (metered). The gpt-realtime-2.1 deployment on Bookie's
# resource is ready for when Presence gains an Azure route for gpt-realtime (open question in
# agent/README.md). Until then the rollback key goes here:
OPENAI_API_KEY=
VOICE_REALTIME_MODEL=gpt-realtime-2.1
VOICE_REALTIME_VOICE=cedar
VOICE_REALTIME_LANGUAGE=en-GB
# Bookie never mutes himself on request from a shared screen or chat text.
VOICE_ALLOW_MIC_MUTE=false

# ---- Vision: Bookie's own resource, managed identity ---------------------------------------
VISION_PROVIDER=azure
AZURE_VISION_ENDPOINT=https://ka-bookie-ai-swc.openai.azure.com
AZURE_VISION_DEPLOYMENT=gpt-6.1-sol
AZURE_VISION_API_KEY=

# ---- Spend meter (docs/SPEND.md): hard monthly cap on metered AI --------------------------------
SPEND_METER=1
SPEND_TOKEN=
SPEND_AZURE_REGION=swedencentral
# /subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.Consumption/budgets/<name>
SPEND_AZURE_BUDGET_ID=
SPEND_ENFORCE=
SPEND_AZURE_ACCOUNT_ID=

# ---- Recordings: Bookie does not serve recordings to a portal ---------------------------------
RECORDINGS_TOKEN=
