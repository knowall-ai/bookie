# ~/.hermes/.env for Bookie (owner bookie, chmod 600). Written by agent/deploy/04, 31, 40 and 41.
# Never commit a filled-in copy. Values that contain spaces or `;` are single-quoted because bash
# scripts (Presence's env.sh, cron gates) source this file too. No inline comments on value lines:
# the Presence bridge reads this file and would keep the comment in the value.

# ---- Brain: Azure OpenAI (ka-bookie-ai-swc) -----------------------------------------------------
# Key of Bookie's own resource: az cognitiveservices account keys list -g <rg> -n <resource>
# Used by model.provider azure-foundry and auxiliary.vision in config.yaml.
AZURE_FOUNDRY_API_KEY=

# ---- Hermes API server (the call-bot's ask_deepbrain) ------------------------------------------
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# Bearer the call-bot presents (DEEPBRAIN_API_KEY in Presence's call-bot .env). openssl rand -hex 32
API_SERVER_KEY=

# ---- Webhook route secret shared with the Presence Graph adapter ------------------------------
# openssl rand -hex 32. Also rendered into config.yaml (platforms.webhook.extra.secret).
GRAPH_WEBHOOK_SECRET=
HERMES_WEBHOOK_URL=http://127.0.0.1:8644

# ---- Presence contract (agent-presence README "The placeholder / env contract") --------------
# ~/presence/scripts/env.sh loads this file for the shared CLIs (graph.mjs, bc.mjs, person360.mjs).
# The Presence systemd units read a smaller file, ~/.hermes/env, written by step 23.
AGENT_NAME=bookie
AGENT_DISPLAY_NAME=Bookie
AGENT_EMAIL=
PRESENCE_STATE_DIR=/home/bookie/.hermes
PRESENCE_DIR=/home/bookie/presence
AGENT_REPO=/home/bookie/bookie
AGENT_WORKSPACE=/home/bookie/.hermes
COMPANY_NAME='KnowAll AI'
BROWSER_OUT_DIR=/home/bookie/tmp/browser
GRAPH_DEFAULT_AUTH=delegated
INTERNAL_DOMAINS=

# ---- Business Central: service-to-service app (agent/deploy/41-install-bc-mcp.sh) ---------------
# Bookie's own Entra app registration, registered in BC's "Microsoft Entra Applications" page.
# Read by the business-central MCP servers through ${BC_*} in config.yaml.
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=Production
# bc.mjs (Presence CLI) default company; the MCP servers carry their own BC_COMPANY.
BC_COMPANY='KnowAll AI Ltd'

# ---- Xero ------------------------------------------------------------------------------------
# Xero credentials are NOT in this file. They live in ~/.config/xero/credentials[.<key>] (chmod 600),
# one Custom Connection per Xero organisation, written by agent/deploy/42-install-xero-credentials.sh.
XERO_SH=/home/bookie/.claude/plugins/marketplaces/knowall-ai/skills/xero/xero.sh
# Read-only scopes requested on every token; a write needs this widened deliberately.
XERO_SCOPE='accounting.transactions.read accounting.reports.read accounting.contacts.read accounting.settings.read'

# ---- Portal links and bill capture (portal + bill-capture skills; written by step 04) -------------
PORTAL_BASE_URL=https://getbook.ie/portal
# <label>=<orgKey>;... e.g. uk=xero.<connectionId>.<tenantId>;sv=bc.Production.<companyId>. Tenant ids:
# set on the VM only.
PORTAL_ORG_KEYS=
ACCOUNTS_MAILBOX=
BILL_CAPTURE_PROCESSED_FOLDER='Bookie/Processed'
BILL_CAPTURE_REVIEW_FOLDER='Bookie/Needs review'
BILL_CAPTURE_TEAMS_TARGET=
BILL_CAPTURE_LOG=teams
BILL_CAPTURE_LOG_SITE=
BILL_CAPTURE_LOG_LIST='Bookie capture log'
BILL_PO_CHECK=auto
BILL_APPROVE_IN_TEAMS=false
BILL_APPROVERS=

# ---- Reverie (agent/deploy/40-install-reverie.sh) ---------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
REVERIE_EMBEDDINGS=local
REVERIE_MODEL_CACHE=/home/bookie/.cache/reverie-models

# ---- Activity telemetry (agent-pulse; agent/deploy/31-setup-telemetry.sh) ----------------------
# Connection string of appi-bookie. Empty = the plugin stays inert. Keep the single quotes.
APPLICATIONINSIGHTS_CONNECTION_STRING=''
AGENT_ID='bookie'

# ---- HUD ---------------------------------------------------------------------------------------
HUD_BRAIN_MODEL=gpt-6.1-sol
USAGE_PROVIDER=none
DEEP_FEED_PROVIDER=hermes
