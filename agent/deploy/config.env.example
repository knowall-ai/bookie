#!/usr/bin/env bash
# =============================================================================
# Bookie the AI bookkeeper: deployment parameters
# =============================================================================
# Copy to config.env (gitignored) and fill in. Every deploy script sources it.
#
#   cp config.env.example config.env && chmod 600 config.env
#
# KnowAll installs Bookie for KnowAll AI with the defaults below. A customer who
# self-hosts changes the identity block (bookie@<their-domain>), the resource
# names and the books block; nothing else in this repo names a tenant.
#
# PUBLIC REPO: no real ids, keys or secrets in this file. Secrets are exported
# at deploy time or prompted for by the script that needs them, never stored here.
# =============================================================================

# ---- Agent identity -----------------------------------------------------------
AGENT_NAME="bookie"                         # unix user on the VM, systemd unit suffix, Azure `agent` tag
AGENT_DISPLAY_NAME="Bookie"
AGENT_UPN="bookie@knowall.ai"               # his own Microsoft 365 account; self-hosters: bookie@<your-domain>
AGENT_EMAIL="${AGENT_UPN}"                  # Presence reads AGENT_EMAIL; keep it equal to the UPN
AGENT_DEPARTMENT="Finance"
AGENT_JOB_TITLE="AI Bookkeeper"
COMPANY_NAME="KnowAll AI"                   # the organisation Bookie works for (SOUL.md, person lookups)
PRINCIPAL_NAME=""                           # optional: the human accountant Bookie escalates to ("Jane Example")
PRINCIPAL_UPN=""                            # optional: their UPN, used for escalations and ops alerts
M365_DOMAIN="knowall.ai"                    # internal mail domain (transport rules, INTERNAL_DOMAINS)
# The organisations whose books Bookie reads, as written into SOUL.md (one line, `;` separated).
ORGANISATIONS="KnowAll AI Ltd (Xero and Business Central); KnowAll AI SAS de CV (Business Central)"
# People who may see ledger data, verified by the channel (Teams/email sender), comma separated.
# Blank means no one: Bookie gives general help only. KnowAll: the directors and the accountant.
AUTHORISED_UPNS=""
AUTHORISED_NAMES=""   # how Bookie names them aloud, e.g. "Alex, Sam and Jo"
OWNER_NAME=""
TRUSTED_EXTERNAL_CALLERS=""   # outside callers recognised on direct calls: "<tenant id>:<object id>,..." (Presence #354)         # who to ask for access, e.g. "Alex"
ACME_EMAIL="${PRINCIPAL_UPN:-}"             # Let's Encrypt contact for Caddy (step 11); blank = none

# ---- Azure: the VM --------------------------------------------------------------
RESOURCE_GROUP="ka-bookie-prod"
VM_NAME="ka-bookie-vm"
VM_LOCATION="uksouth"
VM_SIZE="Standard_D8as_v4"                  # realtime voice + avatar render + Edge; D4s_v4 works for chat-only
VM_IMAGE="Canonical:0001-com-ubuntu-server-jammy:22_04-lts-gen2:latest"
VM_DISK_SIZE=128
VM_ADMIN_USER="kadmin"
VM_TAGS="agent=bookie runtime=hermes agent-customer=knowall agent-teams-upn=${AGENT_UPN}"   # agent-teams-upn: the Agents Portal finds his held emails by it
ADMIN_SOURCE_IP=""                          # your public IP for SSH/RDP; blank = detect with ifconfig.me (12-lockdown-nsg.sh)

# ---- Networking -------------------------------------------------------------------
PUBLIC_DOMAIN="bookie-agent.knowall.ai"     # A record -> the VM's public IP; webhooks only, no portal
GRAPH_ADAPTER_PORT=3005
BRIDGE_STATUS_PORT=3006                     # Presence bridge /status (safe-deploy.sh checks for a live call)

# ---- Security group shared by all AI agents -------------------------------------
SECURITY_GROUP="AI Agents"
SECURITY_GROUP_NICKNAME="ai-agents"
SECURITY_GROUP_DESCRIPTION="Security group for all AI agents. Used to restrict communications (Teams and email) to internal only."

# ---- Microsoft 365 -----------------------------------------------------------------
M365_ADMIN_UPN="${M365_ADMIN_UPN:-}"        # tenant admin who runs steps 05-09 (export it)
M365_SKU_ID="${M365_SKU_ID:-}"              # licence with Teams + Exchange; ./07-assign-license.sh --list
TENANT_ID="${TENANT_ID:-}"                  # Entra tenant id (export it; never commit)
GRAPH_APP_NAME="Bookie MS365 Graph"         # app registration for Bookie's delegated Graph sign-in (step 21)

# ---- Azure OpenAI (step 13) -------------------------------------------------------
AI_RESOURCE_GROUP="${RESOURCE_GROUP}"
AI_RESOURCE_NAME="ka-bookie-ai-swc"
AI_LOCATION="swedencentral"
AI_SKU="S0"
# Deployments on Bookie's own resource. Model versions are filled in at deploy time from
# `az cognitiveservices account list-models` (left blank here on purpose: they change).
AI_BRAIN_DEPLOYMENT="gpt-6.1-sol"
AI_BRAIN_MODEL="gpt-6.1-sol"
AI_BRAIN_MODEL_VERSION=""
AI_BRAIN_CAPACITY=50                        # thousands of tokens per minute (GlobalStandard)
AI_REALTIME_DEPLOYMENT="gpt-realtime-2.1"   # the rollback voice (VOICE_REALTIME_PROVIDER=openai on Azure)
AI_REALTIME_MODEL="gpt-realtime-2.1"
AI_REALTIME_MODEL_VERSION=""
AI_REALTIME_CAPACITY=1
AI_LIVE_DEPLOYMENT="gpt-live-1"             # created only when AI_LIVE_MODEL_VERSION is set and quota exists
AI_LIVE_MODEL="gpt-live-1"
AI_LIVE_MODEL_VERSION=""
AI_LIVE_CAPACITY=1
AI_BUDGET_GBP=300                           # monthly Consumption budget on the AI resource (spend meter reads it)

# ---- Voice: GPT-Live-1 (Agent Presence call-bot) -----------------------------------
VOICE_MODE="realtime"
VOICE_REALTIME_PROVIDER="openai-live"       # gpt-live-1 full duplex. Rollback: "openai" (gpt-realtime-2.1)
VOICE_LIVE_PROVIDER="azure"                 # bill Bookie's voice to an Azure resource, never OpenAI direct
VOICE_LIVE_VOICE="cedar"                    # calm British-leaning male voice; change after a listening test
# Until Bookie's own gpt-live-1 quota is granted, point these at the resource that holds the
# subscription's gpt-live-1 quota (KnowAll: another agent's resource). The VM's managed identity
# needs Cognitive Services OpenAI User there (step 13 grants it when LIVE_RESOURCE_ID is set).
# Afterwards: https://${AI_RESOURCE_NAME}.openai.azure.com and Bookie's own deployments.
AZURE_LIVE_ENDPOINT="https://${AI_RESOURCE_NAME}.openai.azure.com"
AZURE_LIVE_DEPLOYMENT="${AI_LIVE_DEPLOYMENT}"
AZURE_LIVE_BACKEND_DEPLOYMENT="${AI_BRAIN_DEPLOYMENT}"   # must exist on the SAME resource as the live deployment
LIVE_RESOURCE_ID=""                         # /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name> when borrowing quota
VOICE_REALTIME_MODEL="gpt-realtime-2.1"     # used only on rollback (VOICE_REALTIME_PROVIDER=openai)
VOICE_REALTIME_VOICE="cedar"
VOICE_REALTIME_LANGUAGE="en-GB"
AVATAR_LABEL="Bookie-Avatar"                # v4l2loopback card label Teams shows

# ---- Agent Presence (step 23) ------------------------------------------------------
PRESENCE_REPO="git@github.com:knowall-ai/agent-presence.git"   # read-only deploy key on the VM
PRESENCE_PIN=""                             # REQUIRED: the reviewed agent-presence commit Bookie runs (never track main)
PRESENCE_CHECKOUT="/home/${AGENT_NAME}/agent-presence"
PRESENCE_DIR="/home/${AGENT_NAME}/presence"

# ---- Hermes ----------------------------------------------------------------------
AGENT_REPO_URL="https://github.com/knowall-ai/bookie.git"
AGENT_REPO_REF="main"
AGENT_REPO="/home/${AGENT_NAME}/bookie"     # checkout on the VM; skills load from ${AGENT_REPO}/agent/skills
HERMES_DIR="/home/${AGENT_NAME}/.hermes"
HERMES_WEBHOOK_PORT=8644                    # the Presence Graph adapter posts here (HMAC)
HERMES_API_PORT=8642                        # the call-bot's ask_deepbrain posts here (bearer)
MODEL_MAIN="${AI_BRAIN_DEPLOYMENT}"         # Hermes provider azure-foundry, Bookie's own resource
AZURE_AI_BASE_URL="https://${AI_RESOURCE_NAME}.cognitiveservices.azure.com/openai/v1"
TIMEZONE="Europe/London"
HERMES_INSTALL_URL="https://hermes-agent.nousresearch.com/install.sh"
# Marketplace packs linked into the de-duplicated skill farm (link-marketplace-skills.sh).
SKILL_PACKS="knowall-ai"
# <pack>=<git url>, space separated; cloned under SKILLS_SYNC_ROOT by step 04 when missing.
MARKETPLACE_REPOS="knowall-ai=https://github.com/knowall-ai/claude-plugins.git"
# Scheduled jobs (hermes cron, wall-clock in TIMEZONE). Blank = not scheduled.
RECONCILE_CRON="30 8 * * 1"                 # weekly mailbox-vs-books reconcile, Mondays 08:30 (VM starts 08:00); blank = off
RECONCILE_TO="${RECONCILE_TO:-}"            # who gets it (UPNs authorised for every organisation it covers)
MONTH_END_CRON="0 9 2 * *"                  # month-end review on the 2nd at 09:00, sent to PRINCIPAL_UPN
SKILLS_SYNC_ROOT="/home/${AGENT_NAME}/.claude/plugins/marketplaces"
SKILLS_SYNC_ON_CALENDAR="*:0/30"

# ---- Reverie graph memory (step 40) ------------------------------------------------
REVERIE_SERVER_SPEC="@knowall-ai/reverie"  # npm; pin a version (>= 0.4.x, e.g. @knowall-ai/reverie@0.5.3)
REVERIE_PLUGIN_REPO="https://github.com/knowall-ai/hermes-reverie.git"
REVERIE_PLUGIN_REF="main"                   # pin to a reviewed tag/commit
NEO4J_IMAGE="neo4j:5-community"
NEO4J_CONTAINER="neo4j-${AGENT_NAME}"
REVERIE_EMBEDDINGS="local"

# ---- The books ---------------------------------------------------------------------
# Business Central (step 41): one MCP server per BC company; BC_COMPANY_2 blank = only one.
BC_ENVIRONMENT="Production"
BC_COMPANY="KnowAll AI Ltd"
BC_COMPANY_2="KnowAll AI SAS de CV"
BC_MCP_PACKAGE="@knowall-ai/mcp-business-central"   # pin a version, e.g. @knowall-ai/mcp-business-central@1.2.3
BC_APP_NAME="Bookie Business Central"       # service-to-service Entra app (client_credentials)
# Demo mode (optional, SOUL.md): on a call, anyone can switch Bookie to a demo company with fictional
# data (e.g. Microsoft's CRONUS in a BC Sandbox) until the call ends; he may then share its figures
# with everyone on the call. Both blank = off. The environment must not be BC_ENVIRONMENT. Bookie's
# app needs a user there (step 41's BC steps 1-4) with D365 READ, D365 SALES DOC, EDIT, D365 PURCH
# DOC, EDIT, D365 CUSTOMER, EDIT, D365 VENDOR, EDIT, BOOKIE READ and BOOKIE BTC READ. Never a POST set.
DEMO_BC_ENVIRONMENT=""                      # e.g. "Sandbox"
DEMO_BC_COMPANY=""                          # BC company *name*, e.g. "CRONUS UK Ltd."
DEMO_ORG_NAME=""                            # what Bookie calls it, e.g. "CRONUS UK Ltd" (default: the company name)
# Xero (step 42): one Custom Connection per Xero organisation. Keys are the xero.sh company keys.
XERO_COMPANIES="uk"                         # space separated; uk = KnowAll AI Ltd
XERO_SH="/home/${AGENT_NAME}/.claude/plugins/marketplaces/knowall-ai/skills/xero/xero.sh"

# ---- Bill capture from the shared accounts mailbox (steps 10, 21; skill bill-capture) -------
ACCOUNTS_MAILBOX=""                         # e.g. "accounts@example.com"; blank = no bill capture
# How new mail at ACCOUNTS_MAILBOX wakes Bookie:
#   poll    = a hermes cron gate lists the Inbox every BILL_CAPTURE_CRON and wakes him only for
#             new messages (no model call when nothing arrived). Works today.
#   webhook = also a Graph change-notification subscription on the Inbox (step 21), for
#             sub-minute wakes. Needs the Presence adapter to route it (see agent/README.md).
ACCOUNTS_MAILBOX_WAKE="poll"
BILL_CAPTURE_AUTO=0                          # 1 = the capture job runs; 0 = created paused (it drafts bills in the live books)
BILL_CAPTURE_CRON="*/10 7-20 * * 1-5"
BILL_CAPTURE_PROCESSED_FOLDER="Bookie/Processed"
BILL_CAPTURE_REVIEW_FOLDER="Bookie/Needs review"
PORTAL_BASE_URL="https://bookie.knowall.ai/portal"
# Bitcoin wallets (skill: bitcoin; docs/BITCOIN.adoc). The Electrum server Bookie asks about wallet
# addresses, over TLS only (ssl://host:port, certificate verified). Use your own server where you can:
# it learns every address it is asked about. Blank = the bitcoin skill says no server is configured.
BOOKIE_ELECTRUM_URL=""                      # e.g. ssl://electrum.example.com:50002
BOOKIE_ELECTRUM_CERT_SHA256=""              # optional: pin a self-signed certificate (SHA-256 fingerprint)
# Where Bookie posts bill summaries, approval requests and "please approve this new supplier":
# a Teams channel as <teamId>/<channelId> or a chat id. Ids are tenant data: set them on the VM only.
BILL_CAPTURE_TEAMS_TARGET=""
# Capture log (received / drafted / duplicate / needs review / rejected, each with a reason), kept in
# the organisation's own Microsoft 365, never on the VM or in Reverie:
#   sharepoint = a list (one per month view) on BILL_CAPTURE_LOG_SITE / BILL_CAPTURE_LOG_LIST
#   teams      = one post per item in BILL_CAPTURE_TEAMS_TARGET
BILL_CAPTURE_LOG="teams"
BILL_CAPTURE_LOG_SITE=""                    # e.g. https://<tenant>.sharepoint.com/sites/Finance
BILL_CAPTURE_LOG_LIST="Bookie capture log"
BILL_PO_CHECK="auto"                        # auto = only for organisations that use purchase orders; off
# Phase 2, off by default: an authorised approver replies "approve" in the bill's Teams thread and
# Bookie moves the bill from Draft to Awaiting payment. Needs write credentials (see agent/README.md).
BILL_APPROVE_IN_TEAMS="false"
BILL_APPROVERS=""                           # UPNs allowed to approve, space separated; empty = nobody

# ---- Outgoing email (step 08) ---------------------------------------------------------
# Who approves Bookie's email to people outside the organisation, space separated; any one of them
# can approve or reject (Outlook, or the Agents Portal's Approvals tab). Step 14 puts them on Bookie's
# own rule "Moderate External Outbound - Bookie"; step 08 checks they're also on the AI Agents
# catch-all, which knowall-ai/sallie deploy/25 owns. Keep the list the same as Sallie's.
EMAIL_MODERATORS=""

# ---- Telemetry (step 31) -----------------------------------------------------------
AGENT_ID="${AGENT_NAME}"
AGENT_PULSE_PLUGIN_REPO="https://github.com/knowall-ai/poppie-hermes.git"   # until the plugin moves to knowall-ai/agent-pulse
AGENT_PULSE_PLUGIN_PATH="hermes/plugins/agent-pulse"
AGENT_PULSE_PLUGIN_REF="main"               # pin to a reviewed commit
APPLICATIONINSIGHTS_CONNECTION_STRING="${APPLICATIONINSIGHTS_CONNECTION_STRING:-}"   # fetched on the VM, never echoed

# ---- Secrets (export at deploy time; never write them here) -----------------------
AGENT_PASSWORD="${AGENT_PASSWORD:-}"        # initial M365 password for step 05 (prompted if blank)
GRAPH_WEBHOOK_SECRET="${GRAPH_WEBHOOK_SECRET:-}"   # generated by step 04 if blank (openssl rand -hex 32)
API_SERVER_KEY="${API_SERVER_KEY:-}"               # generated by step 04 if blank
